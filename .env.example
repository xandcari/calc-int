# Copiá este archivo como .env.local y completá los valores. Nunca subas .env.local.

# Base de datos (Neon Postgres). Usá la URL de conexión del proyecto, idealmente de un rol con permisos mínimos.
DATABASE_URL=

# Better Auth (obligatoria): mínimo 32 caracteres aleatorios. Generala con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL base de la app: http://localhost:3000 en desarrollo.
BETTER_AUTH_URL=http://localhost:3000

# Login con Google (opcional): si faltan, el botón de Google no se habilita.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dirección pública de la app (opcional): para sitemap, canonical y Open Graph si usás un dominio propio.
# NEXT_PUBLIC_SITE_URL=https://calc-int.vercel.app

# Solo desarrollo: habilita las páginas /test_de_guardado y /test_de_usuario fuera de local.
# PERMITIR_PAGINAS_DE_PRUEBA=
